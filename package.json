{
  "name": "nexo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Nexo — Biblioteca para pensar",
  "scripts": {
    "dev": "concurrently -k -n api,web -c magenta,cyan \"node scripts/dev-api.mjs\" \"vite\"",
    "build": "vite build && go build -o bin/nexo ./cmd/nexo",
    "start": "npm run build && NEXO_ENV=production ./bin/nexo",
    "test": "go test ./... && npm run test:contract",
    "test:contract": "go build -o bin/nexo ./cmd/nexo && vitest run --config contract/vitest.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@tanstack/react-query": "^5.104.5",
    "cmdk": "^1.1.1",
    "d3-force": "^3.0.0",
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0",
    "lucide-react": "^1.60.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "wouter": "^3.13.0"
  },
  "devDependencies": {
    "@types/d3-force": "^3.0.10",
    "@types/d3-selection": "^3.0.12",
    "@types/d3-zoom": "^3.0.9",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
