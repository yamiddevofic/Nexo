# Copia este archivo como .env (no se versiona) y rellena solo lo que vayas a usar.
# Las claves viven aquí, nunca en el vault. Reinicia Nexo tras cambiarlas.

# ── Modelos en la nube (opcionales) ─────────────────────────────
# Lo recomendado es pegar las claves en el panel de IA (se guardan en el llavero del sistema).
# Si prefieres, también puedes definirlas aquí:
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# GROQ_API_KEY=
# DEEPSEEK_API_KEY=
# MISTRAL_API_KEY=

# Modelo por defecto de cada proveedor (también se elige desde el panel de IA)
# NEXO_CLAUDE_MODEL=claude-opus-5-5
# NEXO_OPENAI_MODEL=gpt-4.1-mini
# NEXO_GEMINI_MODEL=gemini-2.5-flash
# NEXO_OPENROUTER_MODEL=openrouter/auto
# NEXO_GROQ_MODEL=llama-3.3-70b-versatile
# NEXO_DEEPSEEK_MODEL=deepseek-chat
# NEXO_MISTRAL_MODEL=mistral-small-latest

# ── Ollama (local) ──────────────────────────────────────────────
# NEXO_OLLAMA_URL=http://127.0.0.1:11434
# NEXO_EMBED_MODEL=embeddinggemma
# NEXO_OLLAMA_MODEL=gemma4:e4b

# Modo sin conexión: solo IA local, nada sale del equipo (también se activa desde el panel de IA).
# NEXO_OFFLINE=1
